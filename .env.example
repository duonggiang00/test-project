# Application
PROJECT_NAME=AI Exam MVP
ENV=development

# Backend database (PostgreSQL is canonical)
# Replace the placeholder password for local use. Do not commit real credentials.
DATABASE_URL=postgresql://ai_exam:replace-with-local-password@127.0.0.1:5432/ai_exam

# Backend security and browser origin
# Generate a local random value; this example is intentionally not a usable secret.
SECRET_KEY=replace-with-at-least-32-random-characters
BACKEND_CORS_ORIGINS=http://localhost:3000

# Optional AI provider credential. Leave empty when AI calls are not exercised.
OPENROUTER_API_KEY=

# Optional AI provider/model policy overrides (app/ai/model_policy.py).
# Every field defaults to the value shown; leaving a per-use-case override
# empty falls back to AI_DEFAULT_MODEL.
AI_PROVIDER=openrouter
AI_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct
AI_MODEL_CHAT=
AI_MODEL_QUESTION_GENERATION=
AI_MODEL_FLASHCARD_GENERATION=
AI_MODEL_TOPIC_BRIEF_GENERATION=
RAG_ENABLED=false

# Browser presentation flag for the temporarily disabled material-chat UI.
# The backend RAG_ENABLED guard remains authoritative if this is enabled.
NEXT_PUBLIC_RAG_ENABLED=false

# Optional per-model token pricing used only to fill the `estimated_cost`
# field of AI audit events (app/ai/cost_policy.py). JSON object of
# {"<model-id>": {"input_per_1k_usd": "0.0002", "output_per_1k_usd": "0.0006"}}.
# Leave empty unless you have an approved price list: with no entry for the
# calling model, audit events record real token counts and a null cost rather
# than a fabricated number.
AI_TOKEN_PRICING=

# Server-only URL used by Next.js route handlers and rewrites.
# Never rename this to a NEXT_PUBLIC_* variable.
BACKEND_API_URL=http://127.0.0.1:8000
