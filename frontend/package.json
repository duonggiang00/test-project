{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.9.0 <25",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check": "npm run lint && npm run build",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:component": "jest --runInBand --testPathPatterns=tests/component",
    "test:unit:coverage": "jest --runInBand --coverage",
    "test:e2e": "npm run test:e2e:real",
    "test:e2e:mocked": "playwright test --config=playwright.mocked.config.ts",
    "test:e2e:real": "playwright test --config=playwright.config.ts",
    "verify": "node ../scripts/verify.mjs frontend"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "ai": "^7.0.42",
    "axios": "^1.18.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.14.1",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
